# =============================================================================
# Numonix Backend - Environment Configuration Template
# Copy this file to .env and configure with your local or production credentials.
# =============================================================================

# --- Application Core ---
APP_NAME="Numonix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_APP_URL=http://localhost:3000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_database
DB_USERNAME=app_user
DB_PASSWORD=secret

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# --- Broadcasting, Filesystem & Queues ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# --- Cache ---
CACHE_STORE=database

# --- Redis (Optional cache/queue accelerator) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail Configuration ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_TOKEN=

# --- AWS S3 (Optional cloud asset storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend Assets ---
VITE_APP_NAME="${APP_NAME}"

# --- Firebase Service Account (FCM Push Notifications & Auth) ---
# Can be a path to JSON file, raw JSON string, or base64 encoded JSON string
FIREBASE_CREDENTIALS=

# --- Paddle Billing & Subscriptions ---
PADDLE_SELLER_ID=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=true
PADDLE_FOUNDER_PRICE_ID=pri_sample_founder
PADDLE_TIER_2_PRICE_ID=pri_sample_tier2
PADDLE_TIER_3_PRICE_ID=pri_sample_tier3
CASHIER_CURRENCY=GBP
CASHIER_CURRENCY_LOCALE=en_GB
CASHIER_LOGGER=stack

# --- Social Authentication ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/social/callback/google

APPLE_CLIENT_ID=com.example.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/social/apple/callback

# --- Maintenance Mode Protection ---
MAINTENANCE_TOKEN=sample-maintenance-token-change-in-production

# --- Laravel Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
